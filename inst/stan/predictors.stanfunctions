/**
 * Average site-level design matrix over surveyed seasons within sites.
 *
 * @param X      Design matrix [K, I, P]
 * @param i_idx  Site indices [K, I]
 * @param I_k    Number of active sites [K]
 *
 * @return  Averaged design matrix [I, P]
 */
matrix average_design_matrix(data array[] matrix X, data array[,] int i_idx,
                             data array[] int I_k) {
  int K = size(X), I = rows(X[1]), P = cols(X[1]);
  array[I] int K_i = zeros_int_array(I);
  matrix[I, P] X_mean = rep_matrix(0, I, P);
  for (k in 1:K) {
    for (i in i_idx[k, :I_k[k]]) {
      X_mean[i] += X[k, i];
      K_i[i] += 1;
    }
  }
  for (i in 1:I) {
    X_mean[i] /= K_i[i];
  }
  return X_mean;
}

/**
 * Average survey-level design matrix over sites and seasons.
 *
 * @param X      Design matrix [I, K, J, P]
 * @param i_idx  Site indices [K, I]
 * @param I_k    Number of sites [K]
 * @param j_idx  Survey indices [K, I, J]
 * @param J_i    Number of surveys [K, I]
 *
 * @return  Averaged design matrix [J_sum, P]
 */
array[] matrix
  average_design_matrix(data array[,] matrix X, data array[,] int i_idx,
                        data array[] int I_k, data array[,,] int j_idx,
                        data array[,] int J_i) {
  int K = size(X), I = size(X[1]), J = rows(X[1, 1]), P = cols(X[1, 1]);
  array[K] matrix[J, P] X_mean = rep_array(rep_matrix(0, J, P), K);
  array[K, J] int N = rep_array(0, K, J);
  for (k in 1:K) {
    for (i in i_idx[k, :I_k[k]]) {
      int J_ik = J_i[k, i];
      array[J_ik] int idx = j_idx[k, i, :J_ik];
      X_mean[k, idx] += X[k, i, idx];
      for (j in idx) {
        N[k, j] += 1;
      }
    }
    for (j in 1:J) {
      if (N[k, j] > 1) {
        X_mean[k, j] /= N[k, j];
      }
    }
  }
  return X_mean;
}

/**
 * Augment continuous design matrix with one-hot coded categorical predictors
 * and ordinal predictors. Overloaded for site and survey-level predictors.
 *
 * @param X      Continuous predictors [K, I, P] or [K, I, J, P]
 * @param X_cat  Categorical predictors [K, I(, J), P]
 * @param X_ord  Ordinal predictors [K, I(, J), P]
 * @param C      Number of levels for categorical predictors [P_cat]
 * @param O      Number of levels for ordinal predictors [P_ord]
 *
 * @return  Augmented design marix
 */
array[] matrix augment_design_matrix(data array[] matrix X,
                                     data array[,,] int X_cat,
                                     data array[,,] int X_ord,
                                     data array[] int C, data array[] int O) {
  int K = size(X), I = rows(X[1]), P = cols(X[1]), P_cat = size(C),
      P_ord = size(O), P_sum = P + P_cat + P_ord, C_sum = sum(C),
      P_aug = P + C_sum - P_cat + P_ord;
  array[K] matrix[I, P_aug] X_aug;
  if (P_sum) {
    if (P) {
      for (k in 1:K) {
        X_aug[k, :, :P] = X[k];
      }
    }
    if (P_cat) {
      int idx = P;
      for (p in 1:P_cat) {
        int C_p = C[p], C_pm1 = C_p - 1;
        for (k in 1:K) {
          for (i in 1:I) {
            X_aug[k, i, idx + 1:idx + C_pm1] =
              one_hot_row_vector(C_p, X_cat[k, i, p])[:C_pm1];
          }
        }
        idx += C_pm1;
      }
    }
    if (P_ord ) {
      for (k in 1:K) {
        X_aug[k, :, P_aug - P_ord + 1:] = to_matrix(X_ord[k]);
      }
    }
  }
  return X_aug;
}

array[,] matrix augment_design_matrix(
  data array[,] matrix X, data array[,,,] int X_cat, data array[,,,] int X_ord,
  data array[] int C, data array[] int O) {
  int K = size(X), I = size(X[1]), J = rows(X[1, 1]), P = cols(X[1, 1]),
      P_cat = size(C), P_ord = size(O), P_sum = P + P_cat + P_ord,
      C_sum = sum(C), P_aug = P + C_sum - P_cat + P_ord;
  array[K, I] matrix[J, P_aug] X_aug;
  if (P) {
    for (k in 1:K) {
      for (i in 1:I) {
        X_aug[k, i, :, :P] = X[k, i];
      }
    }
  }
  if (P_cat) {
    int idx = P;
    for (p in 1:P_cat) {
      int C_p = C[p], C_pm1 = C_p - 1;
      for (k in 1:K) {
        for (i in 1:I) {
          for (j in 1:J) {
            X_aug[k, i, j, idx + 1:idx + C_pm1] =
              one_hot_row_vector(C_p, X_cat[k, i, j, p])[:C_pm1];
          }
        }
      }
      idx += C_pm1;
    }
  }
  if (P_ord ) {
    for (k in 1:K) {
      for (i in 1:I) {
        X_aug[k, i, :, P_aug - P_ord + 1:] = to_matrix(X_ord[k, i]);
      }
    }
  }
  return X_aug;
}

/**
 * Get number of levels for all categorical or ordinal predictors and compute
 * maximum and total levels. Overloaded for site and survey predictors
 *
 * @param X1  Occupancy predictors [K, I, P]
 * @param X2  Detection site predictors [K, I, P]
 * @param X3  Detection survey predictors [K, I, J, P]
 *
 * @return  Number of levels per predictor [3, max(P)]
 */
tuple(array[,] int, array[] int, array[] int)
  levels(data array[,,] int X1, data array[,,] int X2, data array[,,,] int X3) {
  array[3] int P;
  P[1] = size(X1[1, 1]);
  P[2] = size(X2[1, 1]);
  P[3] = size(X3[1, 1, 1]);
  int P_max = max(P), K = size(X1), I = size(X1[1]);
  array[3, P_max] int levels = rep_array(0, 3, P_max);
  for (p in 1:P[1]) {
    for (k in 1:K) {
      levels[1, p] = max(levels[1, p], max(X1[k, :, p]));
    }
  }
  for (p in 1:P[2]) {
    for (k in 1:K) {
      levels[2, p] = max(levels[2, p], max(X2[k, :, p]));
    }
  }
  for (p in 1:P[3]) {
    for (k in 1:K) {
      for (i in 1:I) {
        levels[3, p] = max(levels[3, p], max(X3[k, i, :, p]));
      }
    }
  }
  array[3] int max_levels = zeros_int_array(3),
               sum_levels = zeros_int_array(3);
  for (d in 1:3) {
    if (P[d]) {
      max_levels[d] = max(levels[d]);
      sum_levels[d] = sum(levels[d]);
    }
  }
  return (levels, max_levels, sum_levels);
}

/**
 * Moore–Penrose or pseudo-inverse, with observations in rows and predictors
 * in columns.
 *
 * @param X  Design matrix X [I, P]
 *
 * @return   (X'X)^-1 X'
 */
matrix pseudo_inverse(data matrix X) {
  int I = rows(X), P = cols(X);
  matrix[P, I] Xt = X';
  return inverse_spd(Xt * X) * Xt;
}
