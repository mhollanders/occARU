/**
 * Partial sum function for occARU_lpmf(), summing over regions. Computes
 * random site effects and Poisson OLREs within each region, and increments
 * priors of z-scores.
 *
 * @return  Joint log likelihood and priors across partial regions
 */
real partial_regions_occARU_lpmf(
  data array[] int regions, data int start, data int end,
  data array[] int I_r, data array[] vector XY, data int kernel,
  data matrix X2_aug, data matrix X2_plus, data array[,,] int y,
  data array[,] int Q, data array[,] int j_idx, data array[] int J_i,
  data matrix log_Delta, data matrix X1, data array[,] int X_cat1,
  data array[,] int X_ord1, data matrix X2, data array[,] int X_cat2,
  data array[,] int X_ord2, data array[] matrix X3, data array[,,] int X_cat3,
  data array[,,] int X_ord3, array[] matrix alpha, matrix psi_beta,
  array[] matrix psi_beta_cat, array[] matrix psi_beta_ord, matrix mu_beta,
  array[] matrix mu_beta_cat, array[] matrix mu_beta_ord, matrix gamma,
  array[] matrix gamma_cat, array[] matrix gamma_ord, array[] vector iota_bar_z,
  array[] matrix iota_s_z, vector iota_bar_t, matrix iota_S_L, vector iota_ell,
  matrix kappa, array[] vector epsilon_bar_z, array[] matrix epsilon_z,
  vector epsilon_bar_t, matrix epsilon_S_L, vector phi) {
  int R = size(regions), I = sum(I_r[regions]), I_max = max(I_r[regions]),
      S = size(y[1, 1]), MS = S > 1, random = size(iota_bar_z),
      SS = size(iota_ell) > 1, OLRE = size(epsilon_bar_z);
  real lp = 0.0;
  array[I] int sites = linspaced_int_array(I, sum(I_r[:start - 1]) + 1,
                                              sum(I_r[:end]));
  matrix[random * I, S] iota;
  if (random) {
    vector[I] iota_bar;
    iota_bar = iota_bar_t[1] * iota_bar_z[1, sites];
    lp += std_normal_lpdf(iota_bar_z[1, sites]);
    matrix[MS * I, S] iota_s;
    if (MS) {
      iota_s = iota_s_z[1, sites] * iota_S_L';
      lp += std_normal_lpdf(to_vector(iota_s_z[1, sites]));
    }
    if (kernel) {
      array[R, 1 + SS * S] matrix[I_max, I_max] iota_L =
        site_kernels(I_r[regions], XY[sites], kernel, iota_ell);
      if (MS) {
        if (SS) {
          iota_bar = increment_spatial(I_r[regions], iota_L[:, 1], iota_bar);
          iota_s = increment_spatial(I_r[regions], iota_L, iota_s);
          iota = rep_matrix(iota_bar, S) + iota_s;
        } else {
          iota = increment_spatial(I_r[regions], iota_L,
                                   rep_matrix(iota_bar, S) + iota_s);
        }
      } else {
        iota[:, 1] = increment_spatial(I_r[regions], iota_L[:, 1], iota_bar);
      }
    } else {
      if (MS) {
        iota = rep_matrix(iota_bar, S) + iota_s;
      } else {
        iota[:, 1] = iota_bar;
      }
    }
    if (cols(X2_aug)) {
      iota = orthogonalise(X2_aug[sites], X2_plus[:, sites], iota);
    }
  }
  int J = size(j_idx[1]), J_sum = sum(J_i[sites]);
  array[OLRE * I] matrix[J, S] epsilon;
  if (OLRE) {
    array[J_sum] int surveys =
      linspaced_int_array(J_sum, sum(J_i[:sites[1] - 1]) + 1,
                          sum(J_i[:sites[I]]));
    vector[J_sum] epsilon_bar = epsilon_bar_t[1] * epsilon_bar_z[1, surveys];
    lp += std_normal_lpdf(epsilon_bar_z[1, surveys]);
    matrix[J_sum, S] epsilon_mat;
    if (MS) {
      epsilon_mat = rep_matrix(epsilon_bar, S)
                    + epsilon_z[1, surveys] * epsilon_S_L';
      lp += std_normal_lpdf(to_vector(epsilon_z[1, surveys]));
    } else {
      epsilon_mat[:, 1] = epsilon_bar;
    }
    epsilon = fill_epsilon(j_idx[sites], J_i[sites], epsilon_mat);
  }
  lp += occARU_lpmf(y[sites] | Q[sites], j_idx[sites], J_i[sites],
                    log_Delta[:, sites], X1[sites], X_cat1[sites],
                    X_ord1[sites], X2[sites], X_cat2[sites], X_ord2[sites],
                    X3[sites], X_cat3[sites], X_ord3[sites], alpha[:, sites],
                    psi_beta, psi_beta_cat, psi_beta_ord, mu_beta, mu_beta_cat,
                    mu_beta_ord, gamma, gamma_cat, gamma_ord, iota, kappa,
                    epsilon, phi);
  return lp;
}

/**
 * Partial sum function for multispecies occARU_lpmf(), summing over sites.
 * Computes Poisson OLREs within each region and increments priors of z-scores
 * of random site effects and Poisson OLREs.
 *
 * @return  Joint log likelihood and priors across partial sites
 */
real partial_sites_occARU_lpmf(
  data array[] int sites, data int start, data int end, data array[,,] int y,
  data array[,] int Q, data array[,] int j_idx, data array[] int J_i,
  data matrix log_Delta, data matrix X1, data array[,] int X_cat1,
  data array[,] int X_ord1, data matrix X2, data array[,] int X_cat2,
  data array[,] int X_ord2, data array[] matrix X3, data array[,,] int X_cat3,
  data array[,,] int X_ord3, array[] matrix alpha, matrix psi_beta,
  array[] matrix psi_beta_cat, array[] matrix psi_beta_ord, matrix mu_beta,
  array[] matrix mu_beta_cat, array[] matrix mu_beta_ord, matrix gamma,
  array[] matrix gamma_cat, array[] matrix gamma_ord, matrix iota,
  array[] vector iota_bar_z, array[] matrix iota_z, matrix kappa,
  array[] vector epsilon_bar_z, array[] matrix epsilon_z, vector epsilon_bar_t,
  matrix epsilon_S_L, vector phi) {
  int I = size(sites), J = max(J_i[sites]), S = size(y[1, 1]), MS = S > 1,
      random = size(iota_bar_z), OLRE = size(epsilon_bar_z);
  real lp = 0.0;
  if (random) {
    lp += std_normal_lpdf(iota_bar_z[1, sites]);
    if (MS) {
      lp += std_normal_lpdf(to_vector(iota_z[1, sites]));
    }
  }
  array[OLRE * I] matrix[J, S] epsilon;
  if (OLRE) {
    array[J] int surveys = linspaced_int_array(J, sum(J_i[:sites[1] - 1]) + 1,
                                               sum(J_i[:sites[I]]));
    vector[J] epsilon_bar = epsilon_bar_t[1] * epsilon_bar_z[1, surveys];
    lp += std_normal_lpdf(epsilon_bar_z[1, surveys]);
    matrix[J, S] epsilon_mat;
    if (MS) {
      epsilon_mat = rep_matrix(epsilon_bar, S)
                    + epsilon_z[1, surveys] * epsilon_S_L';
      lp += std_normal_lpdf(to_vector(epsilon_z[1, surveys]));
    } else {
      epsilon_mat[:, 1] = epsilon_bar;
    }
    epsilon = fill_epsilon(j_idx[sites], J_i[sites], epsilon_mat);
  }
  lp += occARU_lpmf(y[sites] | Q[sites], j_idx[sites], J_i[sites],
                    log_Delta[:, sites], X1[sites], X_cat1[sites],
                    X_ord1[sites], X2[sites], X_cat2[sites], X_ord2[sites],
                    X3[sites], X_cat3[sites], X_ord3[sites], alpha[:, sites],
                    psi_beta, psi_beta_cat, psi_beta_ord, mu_beta, mu_beta_cat,
                    mu_beta_ord, gamma, gamma_cat, gamma_ord,
                    random ? iota[sites] : iota, kappa, epsilon, phi);
  return lp;
}

