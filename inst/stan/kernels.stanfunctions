/**
 * Produce Cholesky factors of Gaussian process (GP) kernels for site random
 * effects, for all sites or per region.
 *
 * @param r_idx   Region indices [R, I_max]
 * @param I_r     Number of sites [R]
 * @param XY      Site UTMs (in km) [I, 2]
 * @param kernel  Class of kernel
 * @param ell     Length scales [1( + S)]
 *
 * @return  Cholesky factor(s) of kernel [R, 1( + S), I_max, I_max]
 */
array[,] matrix site_kernels(data array[] int I_r, data array[] vector XY,
                             data int kernel, vector ell) {
  int R = size(I_r), I_max = max(I_r), Sp1 = size(ell);
  array[R, Sp1] matrix[I_max, I_max] L;
  int idx = 0;
  for (r in 1:R) {
    int I_rr = I_r[r];
    array[I_rr] int sites = linspaced_int_array(I_rr, idx + 1, idx + I_rr);
    matrix[I_rr, I_rr] C;
    for (s in 1:Sp1) {
      C = kernel == 1 ?
          gp_exp_quad_cov(XY[sites], 1, ell[s])
          : kernel == 2 ?
            gp_matern32_cov(XY[sites], 1, ell[s])
            : gp_matern52_cov(XY[sites], 1, ell[s]);
      L[r, s, :I_rr, :I_rr] = cholesky_decompose(add_diag(C, 1e-9));
    }
    idx += I_rr;
  }
  return L;
}

/**
 * Produce Cholesky factors of Gaussian process (GP) kernels for survey random
 * effects per season
 *
 * @param J_k      Number of surveys per [K]
 * @param surveys  Survey indices [K, J]
 * @param kernel   Class of kernel
 * @param period   Period length if periodic kernel is included
 * @param tau      Square root of variance partitions of two kernels
 * @param ell      Length scales [1(+ S), 2]
 *
 * @return  Cholesky factor(s) of kernel [K, 1( + S), J, J]
 */
array[,] matrix survey_kernels(data array[] int J_k, data array[,] real surveys,
                               data int kernel, data real period, vector tau,
                               matrix ell) {
  int K = size(surveys), J = size(surveys[1]), periodic = size(tau),
      Sp1 = rows(ell);
  array[K, Sp1] matrix[J, J] L;
  real scale = periodic ? tau[1] : 1;
  for (k in 1:K) {
    int J_kk = J_k[k];
    matrix[J_kk, J_kk] C;
    for (s in 1:Sp1) {
      C = kernel == 1 ?
          gp_exp_quad_cov(surveys[k, :J_kk], scale, ell[s, 1])
          : kernel == 2 ?
            gp_matern32_cov(surveys[k, :J_kk], scale, ell[s, 1])
            : gp_matern32_cov(surveys[k, :J_kk], scale, ell[s, 1]);
      if (periodic) {
        C += gp_periodic_cov(surveys[k, :J_kk], tau[2], ell[s, 2], period);
      }
      L[k, s, :J_kk, :J_kk] = cholesky_decompose(add_diag(C, 1e-9));
    }
  }
  return L;
}

array[] matrix survey_kernels(data array[] real surveys, data int kernel,
                              data real period, vector tau, matrix ell) {
  int J = size(surveys), periodic = size(tau), Sp1 = rows(ell);
  matrix[J, J] C;
  array[Sp1] matrix[J, J] L;
  real scale = periodic ? tau[1] : 1;
  for (s in 1:Sp1) {
    C = kernel == 1 ?
        gp_exp_quad_cov(surveys, scale, ell[s, 1])
        : kernel == 2 ?
          gp_matern32_cov(surveys, scale, ell[s, 1])
          : gp_matern32_cov(surveys, scale, ell[s, 1]);
    if (periodic) {
      C += gp_periodic_cov(surveys, tau[2], ell[s, 2], period);
    }
    L[s] = cholesky_decompose(add_diag(C, 1e-9));
  }
  return L;
}

/**
 * Produce Cholesky factors of Gaussian process (GP) kernels for season random
 * effects.
 *
 * @param seasons  Survey input [N]
 * @param kernel   Class of kernel
 * @param ell      Length scales [1(+ S)]
 *
 * @return         Cholesky factor(s) of kernel [1( + S), K, K]
 */
array[] matrix season_kernels(data array[] real seasons, data int kernel,
                              vector ell) {
  int K = size(seasons), Sp1 = size(ell);
  matrix[K, K] C;
  array[Sp1] matrix[K, K] L;
  for (s in 1:Sp1) {
    C = kernel == 1 ?
        gp_exp_quad_cov(seasons, 1, ell[1])
        : kernel == 2 ?
          gp_matern32_cov(seasons, 1, ell[1])
          : gp_matern52_cov(seasons, 1, ell[1]);
    L[s] = cholesky_decompose(add_diag(C, 1e-9));
  }
  return L;
}
