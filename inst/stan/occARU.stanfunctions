/**
 * Multispecies occupancy model (MSOM) for automated recording unit (ARU) data
 * with Poisson or negative binomial observation process.
 *
 * @param y            Detection history [I, J, S]
 * @param Q            Aggregated detection history [I, S]
 * @param f_l          First and last survey [I, 2]
 * @param log_Delta    Offsets [J, I]
 * @param X2           Site predictors (numeric) for detection [P, I]
 * @param X_cat2       Site predictors (categorical) for detection [P, I]
 * @param X_ord2       Site predictors (ordinal) for detection [P, I]
 * @param X3           Survey predictors (numeric) for detection [I, P, J]
 * @param X_cat3       Survey predictors (categorical) for detection [I, P, J]
 * @param X_ord3       Survey predictors (ordinal) for detection [I, P, J]
 * @param logit_psi    Occupancy logits [S, I]
 * @param alpha        Detection intercepts [S]
 * @param mu_beta      Site coefficients (numeric) [S, P]
 * @param mu_beta_cat  Site coefficients (categorical) [P, S, C_max]
 * @param mu_beta_ord  Site coefficients (realised ordinal) [P, S, O_max]
 * @param gamma        Survey coefficients (numeric) [S, P]
 * @param gamma_cat    Survey coefficients (categorical) [P, S, C_max]
 * @param gamma_ord    Survey coefficients (realised ordinal) [P, S, O_max]
 * @param iota         Site effects [S, I]
 * @param kappa        Survey effects [S, J]
 * @param epsilon      Poisson OLREs (OD = 1)
 * @param phi          Negative binomial overdispersion [S] (OD = 2)
 *
 * @return log_lik   Site-by-species log likelihood [S, I]
 * @return Omega     Marginal occupancy log likelihoods [I, S, 2]
 * @return log_mu    Log detection rates without Poisson OLREs [I, S, J]
 */
tuple(matrix, array[] matrix, array[] matrix)
  occARU(data array[,,] int y, data array[,] int Q, data array[,] int f_l,
         data matrix log_Delta, data matrix X2, data array[,] int X_cat2,
         data array[,] int X_ord2, data array[] matrix X3,
         data array[,,] int X_cat3, data array[,,] int X_ord3, matrix logit_psi,
         vector alpha, matrix mu_beta, array[] matrix mu_beta_cat,
         array[] matrix mu_beta_ord, matrix gamma, array[] matrix gamma_cat,
         array[] matrix gamma_ord, matrix iota, matrix kappa,
         array[] matrix epsilon, vector phi) {
  int I = size(y), J = size(y[1]), S = size(y[1, 1]), OLRE = size(epsilon),
      NB = size(phi), P_cat2 = size(X_cat2), P_ord2 = size(X_ord2),
      P_cat3 = size(X_cat3[1]), P_ord3 = size(X_ord3[1]), SP = cols(iota),
      TE = cols(kappa);
  matrix[S, I] log_psi = log_inv_logit(logit_psi);
  array[I] matrix[S, J] log_mu;
  matrix[S, I] betaX = mu_beta * X2;
  for (p in 1:P_cat2) {
    betaX += mu_beta_cat[p, :, X_cat2[p]];
  }
  if (P_ord2) {
    betaX += increment_ordinal(X_ord2, mu_beta_ord);
  }
  matrix[S, 2] Omega_i;
  array[I] matrix[S, 2] Omega;
  matrix[S, I] log_lik;
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], J_i = l - f + 1;
    array[J_i, S] int y_i = y[i, f:l];
    Omega_i[:, 2] = log_psi[:, i];
    matrix[S, J_i] log_mu_i = rep_matrix(alpha + betaX[:, i], J_i)
                                         + gamma * X3[i, :, f:l]
                                         + rep_matrix(log_Delta[f:l, i]', S);
    if (P_cat3) {
      array[P_cat3, J_i] int X_cat3_i = X_cat3[i, :, f:l];
      for (p in 1:P_cat3) {
        log_mu_i += gamma_cat[p, :, X_cat3_i[p]];
      }
    }
    if (P_ord3) {
      log_mu_i += increment_ordinal(X_ord3[i, :, f:l], gamma_ord);
    }
    if (SP) {
      log_mu_i += rep_matrix(iota[:, i], J_i);
    }
    if (TE) {
      log_mu_i += kappa[:, f:l];
    }
    log_mu[i, :, f:l] = log_mu_i;  // store
    if (OLRE) {
      log_mu_i += epsilon[i, :, f:l];
    }
    for (j in f:l) {
      int jj = j - f + 1;
      if (!is_inf(log_Delta[j, i])) {
        for (s in 1:S) {
          Omega_i[s, 2] += NB ?
                           neg_binomial_2_log_lpmf(y_i[jj, s] | log_mu_i[s, jj],
                                                   phi[s])
                           : poisson_log_lpmf(y_i[jj, s] | log_mu_i[s, jj]);
        }
      }
    }
    for (s in 1:S) {
      if (Q[i, s]) {
        log_lik[s, i] = Omega_i[s, 2];
      } else {
        Omega_i[s, 1] = log_psi[s, i] - logit_psi[s, i];
        log_lik[s, i] = log_sum_exp(Omega_i[s]);
        Omega[i, s] = Omega_i[s];
      }
    }
  }
  return (log_lik, Omega, log_mu);
}

/**
 * Like occARU(), but only outputting joint log likelihood
 *
 * @return log_lik   Joint log likelihood across sites and species
 */
real occARU_lpmf(data array[,,] int y, data array[,] int Q,
                 data array[,] int f_l, data matrix log_Delta, data matrix X2,
                 data array[,] int X_cat2, data array[,] int X_ord2,
                 data array[] matrix X3, data array[,,] int X_cat3,
                 data array[,,] int X_ord3, matrix logit_psi, vector alpha,
                 matrix mu_beta, array[] matrix mu_beta_cat,
                 array[] matrix mu_beta_ord, matrix gamma,
                 array[] matrix gamma_cat, array[] matrix gamma_ord,
                 matrix iota, matrix kappa, array[] matrix epsilon,
                 vector phi) {
  int I = size(y), J = size(y[1]), S = size(y[1, 1]), OLRE = size(epsilon),
      NB = size(phi), P_cat2 = size(X_cat2), P_ord2 = size(X_ord2),
      P_cat3 = size(X_cat3[1]), P_ord3 = size(X_ord3[1]), SP = cols(iota),
      TE = cols(kappa);
  matrix[S, I] log_psi = log_inv_logit(logit_psi);
  matrix[S, I] betaX = mu_beta * X2;
  for (p in 1:P_cat2) {
    betaX += mu_beta_cat[p, :, X_cat2[p]];
  }
  if (P_ord2) {
    betaX += increment_ordinal(X_ord2, mu_beta_ord);
  }
  vector[S] Omega;
  real log_lik = 0.0;
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], J_i = l - f + 1;
    array[J_i, S] int y_i = y[i, f:l];
    Omega = log_psi[:, i];
    matrix[S, J_i] log_mu_i = rep_matrix(alpha + betaX[:, i], J_i)
                              + gamma * X3[i, :, f:l]
                              + rep_matrix(log_Delta[f:l, i]', S);
    if (P_cat3) {
      array[P_cat3, J_i] int X_cat3_i = X_cat3[i, :, f:l];
      for (p in 1:P_cat3) {
        log_mu_i += gamma_cat[p, :, X_cat3_i[p]];
      }
    }
    if (P_ord3) {
      log_mu_i += increment_ordinal(X_ord3[i, :, f:l], gamma_ord);
    }
    if (SP) {
      log_mu_i += rep_matrix(iota[:, i], J_i);
    }
    if (TE) {
      log_mu_i += kappa[:, f:l];
    }
    if (OLRE) {
      log_mu_i += epsilon[i, :, f:l];
    }
    for (j in f:l) {
      int jj = j - f + 1;
      if (!is_inf(log_Delta[j, i])) {
        for (s in 1:S) {
          Omega[s] += NB ?
                      neg_binomial_2_log_lpmf(y_i[jj, s] | log_mu_i[s, jj],
                                              phi[s])
                      : poisson_log_lpmf(y_i[jj, s] | log_mu_i[s, jj]);
        }
      }
    }
    for (s in 1:S) {
      log_lik += Q[i, s] ?
                 Omega[s]
                 : log_sum_exp(log_psi[s, i] - logit_psi[s, i], Omega[s]);
    }
  }
  return log_lik;
}

/**
 * Partial sum function for occARU_lpmf()
 *
 * @return  Joint log likelihood across partial sites and species
 */
real partial_occARU_lpmf(data array[] int sites, data int start, data int end,
                         data array[,,] int y, data array[,] int Q,
                         data array[,] int f_l, data matrix log_Delta,
                         data matrix X2, data array[,] int X_cat2,
                         data array[,] int X_ord2, data array[] matrix X3,
                         data array[,,] int X_cat3, data array[,,] int X_ord3,
                         matrix logit_psi, vector alpha, matrix mu_beta,
                         array[] matrix mu_beta_cat, array[] matrix mu_beta_ord,
                         matrix gamma, array[] matrix gamma_cat,
                         array[] matrix gamma_ord, matrix iota, matrix kappa,
                         array[] matrix epsilon, vector phi) {
  return occARU_lpmf(y[sites] | Q[sites], f_l[sites], log_Delta[:, sites],
                     X2[:, sites], X_cat2[:, sites], X_ord2[:, sites],
                     X3[sites], X_cat3[sites], X_ord3[sites],
                     logit_psi[:, sites], alpha, mu_beta, mu_beta_cat,
                     mu_beta_ord, gamma, gamma_cat, gamma_ord,
                     cols(iota) ? iota[:, sites] : iota, kappa,
                     size(epsilon) ? epsilon[sites] : epsilon, phi);
}


/**
 * Single species occupancy model for automated recording unit (ARU) data with
 * Poisson or negative binomial observation process.
 *
 * @param y            Detection history [I, J]
 * @param Q            Aggregated detection history [I]
 * @param f_l          First and last survey [I, 2]
 * @param log_Delta    Offsets [J, I]
 * @param X2           Site predictors (numeric) for detection [P, I]
 * @param X_cat2       Site predictors (categorical) for detection [P, I]
 * @param X_ord2       Site predictors (ordinal) for detection [P, I]
 * @param X3           Survey predictors (numeric) for detection [I, P, J]
 * @param X_cat3       Survey predictors (categorical) for detection [I, P, J]
 * @param X_ord3       Survey predictors (ordinal) for detection [I, P, J]
 * @param logit_psi    Occupancy logits [I]
 * @param alpha        Detection intercept
 * @param mu_beta      Site coefficients (numeric) [P]
 * @param mu_beta_cat  Site coefficients (categorical) [P, C_max]
 * @param mu_beta_ord  Site coefficients (realised ordinal) [P, O_max]
 * @param gamma        Survey coefficients (numeric) [P]
 * @param gamma_cat    Survey coefficients (categorical) [P, C_max]
 * @param gamma_ord    Survey coefficients (realised ordinal) [P, O_max]
 * @param iota         Site effects [I]
 * @param kappa        Survey effects [J]
 * @param epsilon      Poisson OLREs [J, I] (OD = 1)
 * @param phi          Negative binomial overdispersion (OD = 2)
 *
 * @return log_lik   Site-by-species log likelihood [I]
 * @return Omega     Marginal occupancy log likelihoods [2, I]
 * @return log_mu    Log detection rates without Poisson OLREs [J, I]
 */
tuple(vector, matrix, matrix)
  occARU(data array[,] int y, data array[] int Q, data array[,] int f_l,
         data matrix log_Delta, data matrix X2, data array[,] int X_cat2,
         data array[,] int X_ord2, data array[] matrix X3,
         data array[,,] int X_cat3, data array[,,] int X_ord3,
         row_vector logit_psi, real alpha, row_vector mu_beta,
         matrix mu_beta_cat, matrix mu_beta_ord, row_vector gamma,
         matrix gamma_cat, matrix gamma_ord, row_vector iota, vector kappa,
         matrix epsilon, vector phi) {
  int I = size(y), J = size(y[1]), OLRE = size(epsilon),
      NB = size(phi), P_cat2 = size(X_cat2), P_ord2 = size(X_ord2),
      P_cat3 = size(X_cat3[1]), P_ord3 = size(X_ord3[1]), SP = size(iota),
      TE = size(kappa);
  row_vector[I] log_psi = log_inv_logit(logit_psi),
                log_mu_i = alpha + mu_beta * X2;
  for (p in 1:P_cat2) {
    log_mu_i += mu_beta_cat[p, X_cat2[p]];
  }
  if (P_ord2) {
    log_mu_i += increment_ordinal(X_ord2, mu_beta_ord);
  }
  if (SP) {
    log_mu_i += iota;
  }
  matrix[J, I] log_mu;
  matrix[2, I] Omega;
  Omega[2] = log_psi;
  vector[I] log_lik;
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], J_i = l - f + 1;
    array[J_i] int y_i = y[i, f:l];
    log_mu[f:l, i] = log_mu_i[i] + (gamma * X3[i, :, f:l])' + log_Delta[f:l, i];
    if (P_cat3) {
      array[P_cat3, J_i] int X_cat3_i = X_cat3[i, :, f:l];
      for (p in 1:P_cat3) {
        log_mu[f:l, i] += (gamma_cat[p, X_cat3_i[p]])';
      }
    }
    if (P_ord3) {
      log_mu[f:l, i] += increment_ordinal(X_ord3[i, :, f:l], gamma_ord)';
    }
    if (TE) {
      log_mu[f:l, i] += kappa[f:l];
    }
    vector[J_i] log_mu_j = log_mu[f:l, i];
    if (OLRE) {
      log_mu_j += epsilon[f:l, i];
    }
    for (j in f:l) {
      int jj = j - f + 1;
      if (!is_inf(log_Delta[j, i])) {
        Omega[2, i] += NB ?
                       neg_binomial_2_log_lpmf(y_i[jj] | log_mu_j[jj], phi[1])
                       : poisson_log_lpmf(y_i[jj] | log_mu_j[jj]);
      }
    }
    if (Q[i]) {
      log_lik[i] = Omega[2, i];
    } else {
      Omega[1, i] = log_psi[i] - logit_psi[i];
      log_lik[i] = log_sum_exp(Omega[:, i]);
    }
  }
  return (log_lik, Omega, log_mu);
}

/**
 * Like occARU(), but only outputting joint log likelihood
 *
 * @return  Joint log likelihood across sites
 */
real occARU_lpmf(data array[,] int y, data array[] int Q, data array[,] int f_l,
                 data matrix log_Delta, data matrix X2,
                 data array[,] int X_cat2, data array[,] int X_ord2,
                 data array[] matrix X3, data array[,,] int X_cat3,
                 data array[,,] int X_ord3, row_vector logit_psi, real alpha,
                 row_vector mu_beta, matrix mu_beta_cat, matrix mu_beta_ord,
                 row_vector gamma, matrix gamma_cat, matrix gamma_ord,
                 row_vector iota, vector kappa, matrix epsilon, vector phi) {
  int I = size(y), J = size(y[1]), OLRE = size(epsilon),
      NB = size(phi), P_cat2 = size(X_cat2), P_ord2 = size(X_ord2),
      P_cat3 = size(X_cat3[1]), P_ord3 = size(X_ord3[1]), SP = size(iota),
      TE = size(kappa);
  row_vector[I] log_psi = log_inv_logit(logit_psi),
                log_mu_i = alpha + mu_beta * X2;
  for (p in 1:P_cat2) {
    log_mu_i += mu_beta_cat[p, X_cat2[p]];
  }
  if (P_ord2) {
    log_mu_i += increment_ordinal(X_ord2, mu_beta_ord);
  }
  if (SP) {
    log_mu_i += iota;
  }
  real Omega;
  real log_lik = 0.0;
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], J_i = l - f + 1;
    array[J_i] int y_i = y[i, f:l];
    Omega = log_psi[i];
    vector[J_i] log_mu = log_mu_i[i] + (gamma * X3[i, :, f:l])'
                         + log_Delta[f:l, i];
    if (P_cat3) {
      array[P_cat3, J_i] int X_cat3_i = X_cat3[i, :, f:l];
      for (p in 1:P_cat3) {
        log_mu += (gamma_cat[p, X_cat3_i[p]])';
      }
    }
    if (P_ord3) {
      log_mu += increment_ordinal(X_ord3[i, :, f:l], gamma_ord)';
    }
    if (TE) {
      log_mu += kappa[f:l];
    }
    if (OLRE) {
      log_mu += epsilon[f:l, i];
    }
    for (j in f:l) {
      int jj = j - f + 1;
      if (!is_inf(log_Delta[j, i])) {
        Omega += NB ?
                 neg_binomial_2_log_lpmf(y_i[jj] | log_mu[jj], phi[1])
                 : poisson_log_lpmf(y_i[jj] | log_mu[jj]);
      }
    }
    log_lik += Q[i] ? Omega : log_sum_exp(log_psi[i] - logit_psi[i], Omega);
  }
  return log_lik;
}

/**
 * Partial sum function for occARU_lpmf()
 *
 * @return  Joint log likelihood across partial sites
 */
real partial_occARU_lpmf(data array[] int sites, data int start, data int end,
                         data array[,] int y, data array[] int Q,
                         data array[,] int f_l, data matrix log_Delta,
                         data matrix X2, data array[,] int X_cat2,
                         data array[,] int X_ord2, data array[] matrix X3,
                         data array[,,] int X_cat3, data array[,,] int X_ord3,
                         row_vector logit_psi, real alpha, row_vector mu_beta,
                         matrix mu_beta_cat, matrix mu_beta_ord,
                         row_vector gamma, matrix gamma_cat, matrix gamma_ord,
                         row_vector iota, vector kappa, matrix epsilon, vector phi) {
  return occARU_lpmf(y[sites] | Q[sites], f_l[sites], log_Delta[:, sites],
                     X2[:, sites], X_cat2[:, sites], X_ord2[:, sites],
                     X3[sites], X_cat3[sites], X_ord3[sites], logit_psi[sites],
                     alpha, mu_beta, mu_beta_cat, mu_beta_ord, gamma, gamma_cat,
                     gamma_ord, size(iota) ? iota[sites] : iota, kappa,
                     size(epsilon) ? epsilon[:, sites] : epsilon, phi);
}
