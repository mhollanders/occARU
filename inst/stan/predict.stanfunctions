/**
 * Recover latent occupancy states in dynamic models using the forward-backward
 * sampling algorithm.
 *
 * @param Q      Aggregated counts [K, I, S]
 * @param f_l    First and last season [I, 2]
 * @param Omega  Marginal occupancy log likelihoods [I, S, 2, K]
 * @param log_P  Log transition probability matrices [I, S, K - 1, 2, 2]

 * @return  Latent occupancy states [K, I, S]
 */
array[,,] int occARU_rng(data array[,,] int Q, data array[,] int f_l,
                         array[,] matrix Omega, array[,,] matrix log_P) {
  int K = size(Q), I = size(Q[1]), S = size(Q[1, 1]);
  array[K, I, S] int z = rep_array(0, K, I, S);
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], K_i = l - f;
    for (s in 1:S) {
      z[l, i, s] = Q[l, i, s] ?
                   1 : categorical_logit_rng(Omega[i, s, :, l]) - 1;
    }
    if (K_i) {
      array[K_i] int idx = linspaced_int_array(K_i, f, l - 1);
      for (k in reverse(idx)) {
        int kp1 = k + 1;
        for (s in 1:S) {
          vector[2] lp_k = Omega[i, s, :, k]
                           + log_P[i, s, k, :, z[kp1, i, s] + 1];
          z[k, i, s] = Q[k, i, s] ? 1 : categorical_logit_rng(lp_k) - 1;
        }
      }
    }
  }
  return z;
}

/**
 * Posterior predict Poisson OLREs.
 *
 * @param j_idx  Survey indices [K, I, J]
 * @param J_i    Number of surveys [K, I]
 * @param bar    Mean OLREs [N]
 * @param tau    Scale of mean OLREs
 * @param S_U    Upper triangular Cholesky matrix if multispecies [S]
 *
 * @return       Posterior predictive OLREs in array [K, I, J, S]
 */
array[,] matrix pp_epsilon_rng(data array[,,] int j_idx, data array[,] int J_i,
                               vector bar, vector tau, matrix S_U) {
  int K = size(j_idx), I = size(j_idx[1]), J = size(j_idx[1, 1]), S = cols(S_U),
      N = size(bar), Nm1 = N - 1;
  matrix[N, S] epsilon_mat;
  if (S > 1) {
    int Sm1 = S - 1, NSm1 = Nm1 * Sm1;
    matrix[Nm1, Sm1] u = to_matrix(normal_rng(zeros_vector(NSm1), 1), Nm1, Sm1);
    epsilon_mat = rep_matrix(bar, S) + sum_to_zero_constrain(u) * S_U;
  } else {
    vector[Nm1] u = to_vector(normal_rng(zeros_vector(Nm1), 1));
    epsilon_mat[:, 1] = tau[1] * sum_to_zero_constrain(u);
  }
  return fill_epsilon(j_idx, J_i, epsilon_mat);
}

/**
 * Posterior predictions for occARU model
 *
 * @param f_l        First and last season [I, 2]
 * @param j_idx      Survey indices [K, I, J]
 * @param J_i        Number of surveys [K, I]
 * @param X3         Continuous survey predictors [K, I, J, P]
 * @param logit_psi  Occupancy logits [I, S]
 * @param log_P      Log transition probability matrices [I, K, S, 2, 2]
 * @param log_mu     Log detection rates without OLREs [K, I, J, S]
 * @param gamma      Survey coefficients [P, S]
 * @param phi        Negative binomial overdispersion [S]
 *
 * @return yrep   Survey-level posterior predictions [K, I, J, S]
 * @return Qrep   Site-level aggregated counts [K, I, S]
 */
tuple(array[,,,] int, array[,,] int)
  pp_occARU_rng(data array[,] int f_l, data array[,,] int j_idx,
                data array[,] int J_i, matrix logit_psi, array[,,] matrix log_P,
                array[,] matrix log_mu, vector phi) {
  int K = size(j_idx), I = size(j_idx[1]), J = size(j_idx[1, 1]),
      S = cols(logit_psi), NB = size(phi);
  array[K, I, S] int z, Q = rep_array(0, K, I, S);
  array[K, I, J, S] int y;
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2];
    y[f:l, i] = rep_array(0, l - f + 1, J, S);
    z[f, i] = bernoulli_logit_rng(logit_psi[i]);
    for (k in f + 1:l) {
      int km1 = k - 1;
      for (s in 1:S) {
        z[k, i, s] = categorical_logit_rng(log_P[i, s, km1, z[km1, i, s] + 1]')
                     - 1;
      }
    }
    for (k in f:l) {
      int J_ki = J_i[k, i];
      array[J_ki] int idx = j_idx[k, i, :J_ki];
      matrix[J_ki, S] log_mu_k = log_mu[k, i, idx];
      for (s in 1:S) {
        if (z[k, i, s]) {
          y[k, i, idx, s] = NB ?
                            neg_binomial_2_log_rng(log_mu_k[:, s], phi[s])
                            : poisson_log_rng(log_mu_k[:, s]);
          Q[k, i, s] = sum(y[k, i, idx, s]);
        }
      }
    }
  }
  return (y, Q);
}
