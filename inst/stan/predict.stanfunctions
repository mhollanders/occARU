/**
 * Recover latent occupancy states in single season models.
 *
 * @param Q   Aggregated counts [I, S]
 * @param lp  Output of occARU()

 * @return  Latent occupancy states [I, S]
 */
array[,] int occARU_rng(data array[,] int Q,
                        tuple(matrix, array[] matrix, matrix,
                              array[] matrix) lp) {
  int I = size(Q), S = size(Q[1]);
  array[I, S] int z = rep_array(1, I, S);
  for (i in 1:I) {
    for (s in 1:S) {
      if (!Q[i, s]) {
        z[i, s] = bernoulli_logit_rng(lp.2[i, 2, s] - lp.1[s, i]);
      }
    }
  }
  return z;
}

/**
 * Recover latent occupancy states in dynamic models using the forward-backward
 * sampling algorithm.
 *
 * @param Q   Aggregated counts [I, K, S]
 * @param lp  Output of occARU()

 * @return  Latent occupancy states
 */
array[,,] int occARU_rng(data array[,,] int Q, data array[,] int f_l,
                         tuple(matrix, array[,] matrix, matrix,
                         array[,,] matrix, array[,] matrix) lp) {
  int I = size(Q), K = size(Q[1]), S = size(Q[1, 1]);
  array[K] matrix[2, S] Omega;
  array[K, S] matrix[2, 2] log_P;
  array[I, K, S] int z = rep_array(0, I, K, S);
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2], K_i = l - f;
    Omega = lp.2[i];
    log_P = lp.4[i];
    for (s in 1:S) {
      z[i, l, s] = Q[i, l, s] ? 1 : categorical_logit_rng(Omega[l, :, s]) - 1;
    }
    if (K_i) {
      array[K_i] int idx = linspaced_int_array(K_i, f, l - 1);
      for (k in reverse(idx)) {
        for (s in 1:S) {
          vector[2] lp_k = Omega[k, :, s] + log_P[k, s, :, z[i, k + 1, s] + 1];
          z[i, k, s] = Q[i, k, s] ? 1 : categorical_logit_rng(lp_k) - 1;
        }
      }
    }
  }
  return z;
}

/**
 * Posterior predict Poisson OLREs.
 *
 * @param j_idx  Survey indices [I(, K), J]
 * @param J_i    Number of surveys [I(, K)]
 * @param bar    Mean OLREs [N]
 * @param tau    Scale of mean OLREs
 * @param S_L    Covariance matrix if multispecies [S]
 *
 * @return       Posterior predictive OLREs in array [I, J, S]
 */
array[] matrix pp_epsilon_rng(data array[,] int j_idx, data array[] int J_i,
                              vector bar, vector tau, matrix S_L) {
  int I = size(j_idx), J = size(j_idx[1]), S = cols(S_L), N = size(bar),
      Nm1 = N - 1;
  matrix[N, S] epsilon_mat;
  if (S > 1) {
    int Sm1 = S - 1, NSm1 = Nm1 * Sm1;
    matrix[Nm1, Sm1] u = to_matrix(normal_rng(zeros_vector(NSm1), 1), Nm1, Sm1);
    epsilon_mat = rep_matrix(bar, S) + sum_to_zero_constrain(u) * S_L';
  } else {
    vector[Nm1] u = to_vector(normal_rng(zeros_vector(Nm1), 1));
    epsilon_mat[:, 1] = tau[1] * sum_to_zero_constrain(u);
  }
  return fill_epsilon(j_idx, J_i, epsilon_mat);
}

/**
 * Posterior predictions for single season occARU model.
 *
 * @param j_idx      Survey indices [I, J]
 * @param J_i        Number of surveys [I]
 * @param X3         Continuous survey predictors [I, J, P]
 * @param logit_psi  Occupancy logits [I(, S)]
 * @param log_mu     Log detection rates [I, J, S]
 * @param gamma      Survey coefficients [P, S]
 * @param phi        Negative binomial overdispersion [S]
 *
 * @return yrep   Survey-level posterior predictions [I, J, S]
 * @return Qrep   Site-level aggregated counts [I, S]
 */
tuple(array[,,] int, array[,] int)
  pp_occARU_rng(data array[,] int j_idx, data array[] int J_i,
                data array[] matrix X3, matrix logit_psi, array[] matrix log_mu,
                matrix gamma, vector phi) {
  int I = size(j_idx), J = size(j_idx[1]), S = cols(logit_psi),
      P3 = size(gamma), NB = size(phi);
  array[I, J, S] int y = rep_array(0, I, J, S);
  array[I, S] int Q = rep_array(0, I, S);
  for (i in 1:I) {
    int J_ii = J_i[i];
    array[J_ii] int idx = j_idx[i, :J_ii];
    matrix[J_ii, S] log_mu_i = log_mu[i, idx];
    if (P3) {
      log_mu_i += X3[i, idx] * gamma;
    }
    for (s in 1:S) {
      if (bernoulli_logit_rng(logit_psi[i, s])) {
        y[i, idx, s] = NB ?
                       neg_binomial_2_log_rng(log_mu_i[:, s], phi[s])
                       : poisson_log_rng(log_mu_i[:, s]);
        Q[i, s] = sum(y[i, idx, s]);
      }
    }
  }
  return (y, Q);
}

/**
 * Posterior predictions for dynamic occARU model.
 *
 * @param j_idx      Survey indices [I, K, J]
 * @param J_i        Number of surveys [I, K]
 * @param f_l        First and last season [I, 2]
 * @param X3         Continuous survey predictors [I, K, J, P]
 * @param logit_psi  Occupancy logits [I(, S)]
 * @param log_P      Log transition probability matrices [I, K, S, 2, 2]
 * @param log_mu     Log detection rates without OLREs [I, J, K]
 * @param gamma      Survey coefficients [P(, S)]
 * @param phi        Negative binomial overdispersion [S]
 *
 * @return yrep   Survey-level posterior predictions [I, J, K, S]
 * @return Qrep   Site-level aggregated counts [I, K, S]
 */
tuple(array[,,] int, array[,] int)
  pp_occARU_rng(data array[,,] int j_idx, data array[,] int J_i,
                data array[,] int f_l, data array[,] matrix X3,
                vector logit_psi, array[,] matrix log_P, array[] matrix log_mu,
                vector gamma, vector phi) {
  int I = size(j_idx), K = size(j_idx[1]), J = size(j_idx[1, 1]),
      P3 = size(gamma), NB = size(phi);
  array[I, K] int z, Q = rep_array(0, I, K);
  array[I, J, K] int y = rep_array(0, I, J, K);
  for (i in 1:I) {
    int f = f_l[i, 1], l = f_l[i, 2];
    z[i, f] = bernoulli_logit_rng(logit_psi[i]);
    for (k in f + 1:l) {
      int km1 = k - 1;
      z[i, k] = categorical_logit_rng(log_P[i, km1, z[i, km1]]') - 1;
    }
    for (k in f:l) {
      if (z[i, k]) {
        int J_ii = J_i[i, k];
        array[J_ii] int idx = j_idx[i, k, :J_ii];
        vector[J_ii] log_mu_k = log_mu[i, idx, k];
        if (P3) {
          log_mu_k += X3[i, k, idx] * gamma;
        }
        y[i, idx, k] = NB ?
                       neg_binomial_2_log_rng(log_mu_k, phi[1])
                       : poisson_log_rng(log_mu_k);
        Q[i, k] = sum(y[i, idx, k]);
      }
    }
  }
  return (y, Q);
}
