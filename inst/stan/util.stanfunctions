/**
 * Get indices of regions and number of sites per region.
 *
 * @param region  Region indicator [I]
 *
 * @return r_idx  Indices of regions [R, I]
 * @return I_r    Number of sites [R]
 */
tuple(array[,] int, array[] int) region_indices(data array[] int region) {
  int I = size(region), R = max(region);
  array[R, I] int indices = rep_array(0, R, I);
  array[R] int I_r = zeros_int_array(R);
  for (r in 1:R) {
    int n = 1;
    for (i in 1:I) {
      if (region[i] == r) {
        indices[r, n] = i;
        I_r[r] += 1;
        n += 1;
      }
    }
  }
  return(indices, I_r);
}

/**
 * Get first and last season per site
 *
 * @param J_i  Number of surveys [I, K]
 *
 * @return  First and last season [I, 2]
 */
array[,] int first_last(data array[,] int J_i) {
  int K = size(J_i), I = size(J_i[1]);
  array[I, 2] int f_l;
  for (i in 1:I) {
    for (k in 1:K) {
      if (J_i[k, i]) {
        f_l[i] = rep_array(k, 2);
        break;
      }
    }
    int f = f_l[i, 1], K_i = K - f;
    if (K_i) {
      array[K_i] int idx = linspaced_int_array(K_i, f + 1, K);
      for (k in reverse(idx)) {
        if (J_i[k, i]) {
          f_l[i, 2] = k;
          break;
        }
      }
    }
  }
  return f_l;
}

/**
 * Increment spatial effects to random site effects, potentially by region.
 *
 * @param I_r    Number of sites [R]
 * @param L      GP kernels (lower triangular) [R, S, I_max, I_max]
 * @param iota   Site effects [I, S]
 *
 * @return  L * iota
 */
matrix increment_spatial(data array[] int I_r, array[,] matrix L, matrix iota) {
  int R = size(I_r), I = rows(iota), S = cols(iota), SS = size(L[1]) > 1;
  matrix[I, S] iota_sp;
  int idx = 0;
  for (r in 1:R) {
    int I_rr = I_r[r];
    array[I_rr] int sites = linspaced_int_array(I_rr, idx + 1, idx + I_rr);
    if (SS) {
      array[S] matrix[I_rr, I_rr] L_r = L[r, 2:, :I_rr, :I_rr];
      for (s in 1:S) {
        iota_sp[sites, s] = L_r[s] * iota[sites, s];
      }
    } else {
      iota_sp[sites] = L[r, 1, :I_rr, :I_rr] * iota[sites];
    }
    idx += I_rr;
  }
  return iota_sp;
}

vector increment_spatial(data array[] int I_r, array[] matrix L, vector iota) {
  int R = size(I_r), I = size(iota);
  vector[I] iota_sp;
  int idx = 0;
  for (r in 1:R) {
    int I_rr = I_r[r];
    array[I_rr] int sites = linspaced_int_array(I_rr, idx + 1, idx + I_rr);
    iota_sp[sites] = L[r, :I_rr, :I_rr] * iota[sites];
    idx += I_rr;
  }
  return iota_sp;
}

/**
 * Fill an array of matrices with a matrix
 *
 * @param j_idx         Survey indices [K, I, J]
 * @param J_i           Number of surveys [K, I]
 * @param epsilon_long  "Long" format of OLREs [J_sum, S]
 *
 * @return  Array of matrices of OLREs [K, I, J, S]
 */
array[,] matrix fill_epsilon(data array[,,] int j_idx, data array[,] int J_i,
                            matrix epsilon_long) {
  int K = size(j_idx), I = size(j_idx[1]), J = size(j_idx[1, 1]),
      S = cols(epsilon_long);
  array[K, I] matrix[J, S] epsilon;
  int idx = 0;
  for (k in 1:K) {
    for (i in 1:I) {
      int J_ki = J_i[k, i];
      epsilon[k, i, j_idx[k, i, :J_ki]] = epsilon_long[idx + 1:idx + J_ki];
      idx += J_ki;
    }
  }
  return epsilon;
}

/**
 * Log 2x2 transition probability matrix from log transition rates and interval.
 *
 * @param log_q  Log colonisation and emigration rates
 * @param tau    Time interval
 *
 * @return   log(matrix_exp(Q) * tau), where Q is a 2x2 generator matrix
 */
matrix log_matrix_exp(vector log_q, real tau) {
  real log_S = log_sum_exp(log_q),
       Stau = exp(log_S) * tau,
       log_1mexp_Stau = log1m_exp(-Stau);
  vector[2] log_pi = log_q - log_S;
  return [[ log_sum_exp(log_pi[2], log_pi[1] - Stau),
            log_pi[1] + log_1mexp_Stau ],
          [ log_pi[2] + log_1mexp_Stau,
            log_sum_exp(log_pi[1], log_pi[2] - Stau) ]];
}

/**
 * Elementwise natural logarithm of the product of the elementwise
 * exponentiation of two matrices
 *
 * @param A  First matrix or (row-)vector
 * @param B  Second matrix or (row-)vector
 *
 * @return   log(exp(A) * exp(B))
 */
matrix log_prod_exp(matrix A, matrix B) {
  int I = rows(A), J = cols(A), K = cols(B);
  matrix[J, I] A_tr = A';
  matrix[I, K] C;
  for (k in 1:K) {
    for (i in 1:I) {
      C[i, k] = log_sum_exp(A_tr[:, i] + B[:, k]);
    }
  }
  return C;
}
vector log_prod_exp(matrix A, vector B) {
  int I = rows(A), J = cols(A);
  matrix[J, I] A_tr = A';
  vector[I] C;
  for (i in 1:I) {
    C[i] = log_sum_exp(A_tr[:, i] + B);
  }
  return C;
}
row_vector log_prod_exp(row_vector A, matrix B) {
  int K = cols(B);
  vector[size(A)] A_tr = A';
  row_vector[K] C;
  for (k in 1:K) {
    C[k] = log_sum_exp(A_tr + B[:, k]);
  }
  return C;
}
real log_prod_exp(row_vector A, vector B) {
  return log_sum_exp(A' + B);
}

/**
 * Simplex constrain a zero-sum vector and increment Jacobian adjustment.
 * Differs from simplex_jacobian() in that it does not first
 * sum_to_zero_constrain a free vector.
 *
 * @param u  Sum-to-zero vector
 *
 * @return   Simplex with Jacobian adjustment
 */
vector sum_to_zero_simplex_jacobian(vector u) {
  int J = size(u);
  real r = log_sum_exp(u);
  jacobian += sum(u) - J * r;
  return exp(u - r);
}

/**
 * Get indices of active surveys (where Delta > 0) and number of surveys.
 * Overload for single- and multiseason deployments.
 *
 * @param Delta  Survey effort [I, J, K]
 *
 * @return indices  Indices of active surveys [K, I, J]
 * @return J_i      Number of surveys [K, I]
 */
tuple(array[,,] int, array[,] int) survey_indices(data array[] matrix Delta) {
  int K = size(Delta), J = rows(Delta[1]), I = cols(Delta[1]);
  array[K, I, J] int indices = rep_array(0, K, I, J);
  array[K, I] int J_i = rep_array(0, K, I);
  for (k in 1:K) {
    for (i in 1:I) {
      for (j in 1:J) {
        if (Delta[k, j, i] > 0) {
          J_i[k, i] += 1;
          indices[k, i, J_i[k, i]] = j;
        }
      }
    }
  }
  return (indices, J_i);
}

/**
 * Get indices of active sites and number of sites per season
 *
 * @param J_i  Number of surveys [K, I]
 *
 * @return indices  Indices of active sites [K, I]
 * @return I_k      Number of active sites [K]
 */
tuple(array[,] int, array[] int) site_indices(data array[,] int J_i) {
  int K = size(J_i), I = size(J_i[1]);
  array[K, I] int indices = rep_array(0, K, I);
  array[K] int I_k = zeros_int_array(K);
  for (k in 1:K) {
    for (i in 1:I) {
      if (J_i[k, i]) {
        I_k[k] += 1;
        indices[k, I_k[k]] = i;
      }
    }
  }
  return (indices, I_k);
}
